{
  "artifact": "per-scheme quantization accuracy-delta envelope",
  "what_it_is": "the observed distribution of (quantized - original) accuracy in percentage points on OpenLLM-style benchmarks, per quantization scheme, with a split-conformal 90% interval: the centre is estimated on the fit side of a fixed checkpoint partition and the half-width from residuals on the disjoint calibration side, so the interval carries the split-conformal guarantee. Its strength is limited by the number of exchangeable units behind each width, which is 2 to 8 checkpoints per scheme. It is a calibrated historical baseline, NOT a per-model predictor.",
  "built": "2026-10-07",
  "alpha": 0.1,
  "target": "acc_after - acc_before, percentage points",
  "training_data": {
    "source": "RedHatAI model cards on Hugging Face",
    "rows": 823,
    "checkpoints": 38,
    "families": 6,
    "benchmarks": 21
  },
